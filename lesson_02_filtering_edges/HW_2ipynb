{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMM+6Vix9nJJH5t19XRZStl"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["\n","## 1. Основне завдання\n","Завантажте власне фото з кількома схожими об'єктами (монети, таблетки, ґудзики тощо) і застосуйте функцію `count_objects()` з ноутбука.\n","Підберіть параметри `min_area`, `blur_k`, `canny_lo` / `canny_hi` так, щоб пайплайн порахував усі об'єкти правильно.\n","У відповіді коротко напишіть, які значення спрацювали і де пайплайн помилявся.\n","\n","---\n","\n","## 2. Додаткова практика\n","* Порівняйте `GaussianBlur (3,3)` і `(21,21)` на своєму фото – як змінюється результат Canny;\n","* Спробуйте `THRESH_OTSU` і `adaptiveThreshold` на фото з нерівним освітленням;\n","* Замініть `MORPH_CLOSE` на `MORPH_OPEN` перед `findContours` – що зміниться;\n","* **Bonus:** Намалюйте коло через `cv2.minEnclosingCircle` замість bounding box."],"metadata":{"id":"R5Gl1yW3dEHm"}},{"cell_type":"code","execution_count":5,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":521},"id":"AVAeD03wYfya","executionInfo":{"status":"ok","timestamp":1787340131718,"user_tz":-180,"elapsed":1001,"user":{"displayName":"Максим Злачевский","userId":"05537400500044071436"}},"outputId":"81712000-7c73-4470-ede2-b5588b0ca071"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["import cv2\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","def count_coins_final(img_path):\n","    # 1. Завантаження фото\n","    img_bgr = cv2.imread(img_path)\n","    if img_bgr is None:\n","        print(\"Помилка: файл не знайдено!\")\n","        return\n","\n","    # 2. Ресайз до 800px\n","    h, w = img_bgr.shape[:2]\n","    target_w = 800\n","    target_h = int(h * (target_w / w))\n","    img_resized = cv2.resize(img_bgr, (target_w, target_h))\n","\n","    img_rgb = cv2.cvtColor(img_resized, cv2.COLOR_BGR2RGB)\n","    gray = cv2.cvtColor(img_resized, cv2.COLOR_BGR2GRAY)\n","\n","    # 3. Гаусс. розмиття\n","    blurred = cv2.GaussianBlur(gray, (5, 5), 0)\n","\n","    # 4. Canny\n","    edges = cv2.Canny(blurred, 30, 100)\n","\n","    # 5. Закриття щілей ядром5, 5)\n","    kernel = np.ones((5, 5), np.uint8)\n","    closed = cv2.morphologyEx(edges, cv2.MORPH_CLOSE, kernel)\n","\n","    # 6. Пошук контурів\n","    cnts, _ = cv2.findContours(closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n","\n","    # 7. Відсіювання по порогу площі\n","    MIN_AREA = 250\n","    valid_cnts = [c for c in cnts if cv2.contourArea(c) > MIN_AREA]\n","\n","    # 8. Контури, крапка в центрі та нумерація\n","    vis = img_rgb.copy()\n","    for idx, c in enumerate(valid_cnts, 1):\n","        x, y, w, h = cv2.boundingRect(c)\n","        cv2.rectangle(vis, (x, y), (x + w, y + h), (0, 255, 0), 2)\n","        (cx, cy), radius = cv2.minEnclosingCircle(c)\n","        cv2.circle(vis, (int(cx), int(cy)), int(radius), (0, 255, 0), 2)\n","        cv2.circle(vis, (int(cx), int(cy)), 3, (255, 0, 0), -1)\n","        cv2.putText(vis, f'#{idx}', (int(cx) - 15, int(cy) - 15),\n","                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 200, 0), 2)\n","\n","    plt.figure(figsize=(9, 6))\n","    plt.imshow(vis)\n","    plt.title(f\"Успішно знайдено монет: {len(valid_cnts)} / 5\")\n","    plt.axis('off')\n","    plt.show()\n","\n","# Запускаємо\n","count_coins_final('my_coins.jpg')"]},{"cell_type":"markdown","source":["### 📌 Короткий звіт\n","\n","* **Де пайплайн помилявся (на початкових параметрах):**\n","  * При порогах `Canny(50, 150)` та `min_area = 500` пайплайн знаходив тільки 4 монети з 5.\n","  * Найдрібніша та бліда срібляста монета пропускалася, бо її межа сливалася з папером і відсіювалася за площею.\n","\n","* **Які значення спрацювали:**\n","  * `resize` = `800px` *(нормування масштабу)*\n","  * `GaussianBlur` = `(5, 5)`\n","  * `Canny` пороги = `(30, 100)` *(підхопили малоконтрастну сріблясту монету)*\n","  * `MORPH_CLOSE` = `5x5` *(затягнули мікророзриви в контурах)*\n","  * `min_area` = `250` *(пропустили найдрібнішу монету)*\n","\n","* **Підсумок:** Знайдено **5 з 5 монет (100%)**."],"metadata":{"id":"4KHmbb6fc-q4"}},{"cell_type":"code","source":["import cv2\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# 1. Завантаження та підготовка фото\n","img = cv2.imread('my_coins.jpg')\n","h, w = img.shape[:2]\n","img_resized = cv2.resize(img, (800, int(h * (800 / w))))\n","img_rgb = cv2.cvtColor(img_resized, cv2.COLOR_BGR2RGB)\n","gray = cv2.cvtColor(img_resized, cv2.COLOR_BGR2GRAY)\n","\n","# 2. Порівняння GaussianBlur (3,3) vs (21,21)\n","blur_small = cv2.GaussianBlur(gray, (3, 3), 0)\n","blur_large = cv2.GaussianBlur(gray, (21, 21), 0)\n","canny_3 = cv2.Canny(blur_small, 30, 100)\n","canny_21 = cv2.Canny(blur_large, 30, 100)\n","\n","# 3. Порівняння THRESH_OTSU з adaptiveThreshold\n","_, th_otsu = cv2.threshold(blur_small, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n","th_adapt = cv2.adaptiveThreshold(blur_small, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,\n","                                 cv2.THRESH_BINARY, 11, 2)\n","\n","# 4. Порівняння MORPH_CLOSE з MORPH_OPEN\n","edges_std = cv2.Canny(cv2.GaussianBlur(gray, (5, 5), 0), 30, 100)\n","kernel = np.ones((5, 5), np.uint8)\n","m_close = cv2.morphologyEx(edges_std, cv2.MORPH_CLOSE, kernel)\n","m_open = cv2.morphologyEx(edges_std, cv2.MORPH_OPEN, kernel)\n","\n","# 5. Bonus: minEnclosingCircle\n","cnts, _ = cv2.findContours(m_close, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n","vis_bonus = img_rgb.copy()\n","for c in cnts:\n","    if cv2.contourArea(c) > 250:\n","        (x, y), r = cv2.minEnclosingCircle(c)\n","        cv2.circle(vis_bonus, (int(x), int(y)), int(r), (0, 255, 0), 2)\n","        cv2.circle(vis_bonus, (int(x), int(y)), 2, (255, 0, 0), -1)\n","\n","# 6. Візуалізація результатів (2x4)\n","fig, axes = plt.subplots(2, 4, figsize=(18, 8))\n","\n","# Верхній ряд\n","axes[0, 0].imshow(canny_3, cmap='gray'); axes[0, 0].set_title('Blur (3,3): Дрібний шум')\n","axes[0, 1].imshow(canny_21, cmap='gray'); axes[0, 1].set_title('Blur (21,21): Втрата меж')\n","axes[0, 2].imshow(th_otsu, cmap='gray'); axes[0, 2].set_title('THRESH_OTSU')\n","axes[0, 3].imshow(th_adapt, cmap='gray'); axes[0, 3].set_title('adaptiveThreshold')\n","\n","# Нижній ряд\n","axes[1, 0].imshow(m_close, cmap='gray'); axes[1, 0].set_title('MORPH_CLOSE (Зклеює межі)')\n","axes[1, 1].imshow(m_open, cmap='gray'); axes[1, 1].set_title('MORPH_OPEN (Розриває межі)')\n","axes[1, 2].imshow(vis_bonus); axes[1, 2].set_title('Bonus: minEnclosingCircle')\n","axes[1, 3].axis('off') # Пустий блок для симетрії\n","\n","for ax in axes.ravel()[:7]:\n","    ax.axis('off')\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":576},"id":"mCbU23zWd3zn","executionInfo":{"status":"ok","timestamp":1786546460951,"user_tz":-180,"elapsed":1643,"user":{"displayName":"Максим Злачевский","userId":"05537400500044071436"}},"outputId":"0f2cf63f-fb0a-486a-a93c-b303cbe0a4b6"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x800 with 8 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["### 🧪 2. Додаткова практика (Висновки за графіками)\n","\n","* **`GaussianBlur (3,3)` vs `(21,21)`:**\n","  * **При `(3,3)`:** Розмиття занадто слабке — Canny промалював дрібне внутрішнє карбування монет (забагато зайвих деталей).\n","  * **При `(21,21)`:** Перерозмиття — алгоритм повністю втратив 3 монети з 5, залишивши від інших лише короткі дуги.\n","\n","* **`THRESH_OTSU` vs `adaptiveThreshold`:**\n","  * **`THRESH_OTSU`:** Глобальний поріг створив величезну чорну пляму в лівому кутку через тінь та злив деталі монет.\n","  * **`adaptiveThreshold`:** Локально підлаштувався під світло й чітко проявив контури всіх 5 монет (з невеликим шумом на тлі).\n","\n","* **`MORPH_CLOSE` vs `MORPH_OPEN`:**\n","  * **`MORPH_CLOSE`:** Успішно затягнув внутрішній простір та склеїв розриви контурів монет.\n","  * **`MORPH_OPEN`:** Першою ж ерозією повністю знищив тонкі лінії Canny (кадр став абсолютно чорним).\n","\n","* **Bonus (`cv2.minEnclosingCircle`):**\n","  * Ідеально обвів усі 5 монет акуратними зеленими колами з позначенням центрів."],"metadata":{"id":"l8Msqd5-e5qq"}}]}